# The tracked WinGet manifests exist to reproduce a submission exactly, so they
# must keep the bytes that were submitted rather than this machine's line
# endings. Everything else, this directory's own README included, follows the
# repository's normal CRLF checkout.
packaging/winget/*/*.yaml -text

# The Cloudflare mirror parses these at the edge line by line, and the IndexNow
# key file is compared against the key we submit. A CR that this repository's
# CRLF default would otherwise add lands inside a header value or the key, so
# these four keep LF on every checkout.
docs/_headers text eol=lf
docs/_redirects text eol=lf
docs/*.txt text eol=lf
